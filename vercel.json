{
  "version": 2,
  "buildCommand": "npm --prefix client run build && npm --prefix server install",
  "outputDirectory": "client/dist",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/[...route].js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...route].js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
